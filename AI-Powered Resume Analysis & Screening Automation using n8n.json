    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"name\": \"resume_screening_evaluation\",\n  \"description\": \"Analyzes a candidate's resume against a job description and outputs strengths, weaknesses, risk/reward assessment, and an overall fit score.\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"candidate_strengths\": {\n      \"type\": \"array\",\n      \"description\": \"A list of specific strengths, skills, qualifications, certifications, and experiences that match the job description.\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"candidate_weaknesses\": {\n      \"type\": \"array\",\n      \"description\": \"A list of missing skills, qualifications, experience gaps, or weaknesses identified in the candidate's resume compared to the job requirements.\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"risk_factor\": {\n      \"type\": \"object\",\n      \"description\": \"An evaluation of the potential risks of hiring this candidate.\",\n      \"properties\": {\n        \"score\": {\n          \"type\": \"string\",\n          \"enum\": [\"Low\", \"Medium\", \"High\"],\n          \"description\": \"The risk level of hiring this candidate.\"\n        },\n        \"explanation\": {\n          \"type\": \"string\",\n          \"description\": \"A brief explanation of the potential risks, skill gaps, or concerns associated with hiring this candidate.\"\n        }\n      },\n      \"required\": [\n        \"score\",\n        \"explanation\"\n      ],\n      \"additionalProperties\": false\n    },\n    \"reward_factor\": {\n      \"type\": \"object\",\n      \"description\": \"An evaluation of the potential benefits and value of hiring this candidate.\",\n      \"properties\": {\n        \"score\": {\n          \"type\": \"string\",\n          \"enum\": [\"Low\", \"Medium\", \"High\"],\n          \"description\": \"The potential reward level of hiring this candidate.\"\n        },\n        \"explanation\": {\n          \"type\": \"string\",\n          \"description\": \"A brief explanation of the candidate's potential contributions, strengths, and expected value to the organization.\"\n        }\n      },\n      \"required\": [\n        \"score\",\n        \"explanation\"\n      ],\n      \"additionalProperties\": false\n    },\n    \"overall_fit_rating\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"Poor Fit\",\n        \"Moderate Fit\",\n        \"Good Fit\",\n        \"Excellent Fit\"\n      ],\n      \"description\": \"The overall suitability of the candidate for the job based on resume and job description alignment.\"\n    },\n    \"justification_for_rating\": {\n      \"type\": \"string\",\n      \"description\": \"A detailed explanation of why the candidate received the specific fit rating, referencing resume and job description alignment.\"\n    }\n  },\n  \"required\": [\n    \"candidate_strengths\",\n    \"candidate_weaknesses\",\n    \"risk_factor\",\n    \"reward_factor\",\n    \"overall_fit_rating\",\n    \"justification_for_rating\"\n  ],\n  \"additionalProperties\": false\n}"
      },
